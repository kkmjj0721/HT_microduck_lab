# Python 环境、字节码与构建产物
/.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# 检查、仿真与编译缓存；临时测试脚本与验证产物统一写入 .artifacts/
.pytest_cache/
.ruff_cache/
.mypy_cache/
/.cache/
/.warp_cache/
/.torchinductor_cache/
/.artifacts/
/MUJOCO_LOG.TXT

# 本地测试源码及测试数据，仅在本地保留
/tests/

# 测试工具缓存、覆盖率数据及报告
.hypothesis/
.tox/
.nox/
/.coverage
/.coverage.*
/htmlcov/
/coverage.xml
/junit.xml
/test-results/
/test-reports/

# 根目录的训练、评估及导出产物；源码与测试中的同名目录保留
/outputs/
/logs/
/runs/
/wandb/
/checkpoints/
/exports/
/videos/

# 本地工作文档及配图，含已有文档、模板与归档
/docs/work/
/docs/design/
/docs/review/
/docs/archive/
/docs/development_workflow.md
/docs/development.md
/docs/collaboration_review.md

# 正式技术文档、模型资源与 uv.lock 保持可跟踪
